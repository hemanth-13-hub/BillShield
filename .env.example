# BillShield Example Environment Configuration
# Copy relevant entries into backend/.env or frontend/.env.local as needed.
# Placeholder values only — NEVER commit real credentials, tokens, or personal student data.

# ── Backend (FastAPI / SQLite) ───────────────────────────────────────────────
APP_NAME=BillShield API
APP_VERSION=1.0.0
HOST=127.0.0.1
PORT=8000
RELOAD=true

# SQLite database path relative to backend/
DATABASE_URL=sqlite:///./billshield.db

# Comma-separated or JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Default electricity tariff & verification match threshold
DEFAULT_RATE_PER_UNIT=10.0
DEFAULT_TOLERANCE_PERCENT=5.0

# ── Frontend (Vite / React) ──────────────────────────────────────────────────
VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=/api/v1

# ── Optional Future Hardware Webhook Secret (Placeholder Only) ───────────────
# Not active until physical ESP32 hardware integration is implemented.
SENSOR_INGEST_SHARED_SECRET=replace-with-local-dev-placeholder

